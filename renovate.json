{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned container images in formulas/*/map.jinja ('image' line, then 'tag' line; also the dind_ pair of forgejo-runner)",
      "managerFilePatterns": ["/^formulas/[^/]+/map\\.jinja$/"],
      "matchStrings": [
        "'image':\\s*'(?<depName>[^']+)',\\s*\\n\\s*'tag':\\s*'(?<currentValue>[^']+)'",
        "'dind_image':\\s*'(?<depName>[^']+)',\\s*\\n\\s*'dind_tag':\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Forgejo is the deploy source: stay on the 15.x LTS line until the next LTS",
      "matchDepNames": ["data.forgejo.org/forgejo/forgejo"],
      "allowedVersions": "<16.0.0"
    },
    {
      "description": "LSIO Jellyfin tags: <major>.<minor>[.<patch>]ubu<ubuntu>-ls<build>",
      "matchDepNames": ["lscr.io/linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?ubu(?<compatibility>\\d+)-ls(?<build>\\d+)$"
    }
  ]
}
