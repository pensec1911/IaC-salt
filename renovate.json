{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned container images in formulas/*/map.jinja ('image' line, then 'tag' line; also prefixed pairs like dind_image/dind_tag)",
      "managerFilePatterns": ["/^formulas/[^/]+/map\\.jinja$/"],
      "matchStrings": [
        "'(?:[a-z]+_)?image':\\s*'(?<depName>[^']+)',\\s*\\n\\s*'(?:[a-z]+_)?tag':\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Salt version pin (formulas/salt-minion version; rolled out by orch.salt-upgrade)",
      "managerFilePatterns": ["/^pillar/salt-minion-version\\.sls$/"],
      "matchStrings": ["\\btarget:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "salt-common",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://packages.broadcom.com/artifactory/saltproject-deb?suite=stable&components=main&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "description": "caddy-dns/porkbun plugin built into the Caddy image on edge (formulas/caddy porkbun_version)",
      "managerFilePatterns": ["/^formulas/caddy/map\\.jinja$/"],
      "matchStrings": ["'porkbun_version':\\s*'(?<currentValue>v[^']+)'"],
      "depNameTemplate": "github.com/caddy-dns/porkbun",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "LSIO qBittorrent: tags 20.x/14.x are ancient pre-5.x releases from an older tag scheme, not upgrades",
      "matchDepNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": "<14.0.0"
    },
    {
      "description": "PatchMon's Postgres stays on 17 (patch/minor only): a major needs a dump/restore of its data dir, not a tag bump",
      "matchDepNames": ["docker.io/library/postgres"],
      "matchFileNames": ["formulas/patchmon/map.jinja"],
      "allowedVersions": "<18.0.0"
    },
    {
      "description": "Postgres stays on 18 (authentik, netbox, paperless, tofu-state): a major needs a dump/restore per service (known-issues), and the apps don't test 19 yet",
      "matchDepNames": ["docker.io/library/postgres"],
      "matchFileNames": ["formulas/authentik/map.jinja", "formulas/netbox/map.jinja", "formulas/paperless/map.jinja", "formulas/tofu-state/map.jinja"],
      "allowedVersions": "<19.0.0"
    },
    {
      "description": "Salt: stay on the 3008 LTS line (Tofu's bootstrap pin is 3008.*); a new major is a manual decision",
      "matchDepNames": ["salt-common"],
      "matchDatasources": ["deb"],
      "allowedVersions": "/^3008\\./"
    },
    {
      "description": "Forgejo is the deploy source: stay on the 15.x LTS line until the next LTS",
      "matchDepNames": ["data.forgejo.org/forgejo/forgejo"],
      "allowedVersions": "<16.0.0"
    },
    {
      "description": "LSIO Jellyfin tags: <major>.<minor>[.<patch>]ubu<ubuntu>-ls<build>",
      "matchDepNames": ["lscr.io/linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?ubu(?<compatibility>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "IT-Tools tags: <date>-<commit>; ordered by the date, the commit hash is ignored",
      "matchDepNames": ["ghcr.io/corentinth/it-tools"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "netbox-docker tags: v<NetBox version>-<netbox-docker version>; ordered by NetBox, then the image's major.minor",
      "matchDepNames": ["docker.io/netboxcommunity/netbox"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)\\.(?<revision>\\d+)\\.\\d+$"
    }
  ]
}
