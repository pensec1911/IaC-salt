{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned container images in formulas/*/map.jinja ('image' line, then 'tag' line; also prefixed pairs like dind_image/dind_tag)",
      "managerFilePatterns": ["/^formulas/[^/]+/map\\.jinja$/"],
      "matchStrings": [
        "'(?:[a-z]+_)?image':\\s*'(?<depName>[^']+)',\\s*\\n\\s*'(?:[a-z]+_)?tag':\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Forgejo is the deploy source: stay on the 15.x LTS line until the next LTS",
      "matchDepNames": ["data.forgejo.org/forgejo/forgejo"],
      "allowedVersions": "<16.0.0"
    },
    {
      "description": "LSIO Jellyfin tags: <major>.<minor>[.<patch>]ubu<ubuntu>-ls<build>",
      "matchDepNames": ["lscr.io/linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?ubu(?<compatibility>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "netbox-docker tags: v<NetBox version>-<netbox-docker version>; ordered by NetBox, then the image's major.minor",
      "matchDepNames": ["docker.io/netboxcommunity/netbox"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)\\.(?<revision>\\d+)\\.\\d+$"
    }
  ]
}
