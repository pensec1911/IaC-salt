{#- allowed_hosts is required by homepage itself (Next.js host header
   check) — every hostname/IP:port it'll be reached as must be listed or
   it 500s. #}
{%- set defaults = {
    'image': 'ghcr.io/gethomepage/homepage',
    'tag': 'v2.3.0',
    'container_name': 'homepage',
    'host_port': 3000,
    'config_dir': '/opt/homepage/config',
    'puid': 1000,
    'pgid': 1000,
    'timezone': 'Etc/UTC',
    'allowed_hosts': 'localhost:3000,127.0.0.1:3000',
} %}
{%- set homepage = salt['pillar.get']('homepage:lookup', default=defaults, merge=True) %}
