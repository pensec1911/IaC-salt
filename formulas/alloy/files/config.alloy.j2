{%- from "alloy/map.jinja" import alloy with context -%}
// Managed by formulas/alloy — host journal (incl. container logs) -> Loki.
//
// Podman's journald log driver writes every container line to the journal
// with CONTAINER_NAME set: those get job="container" and container=<name>,
// everything else job="journal". unit is set on both (a container's lines
// carry its Quadlet unit, <name>.service).

loki.relabel "journal" {
  forward_to = []

  rule {
    target_label = "job"
    replacement  = "journal"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "(.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = ".+"
    target_label  = "job"
    replacement   = "container"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  path          = "/var/log/journal"
  max_age       = "{{ alloy.journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "{{ alloy.loki_url }}/loki/api/v1/push"
  }

  external_labels = {"host" = "{{ grains['id'] }}"}
}
