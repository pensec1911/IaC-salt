{%- set arrstack = salt['pillar.get']('arrstack:lookup', default=defaults, merge=True) %}

{#- Derived: how a container joins gluetun's network namespace. Quadlet's
   Network=<unit>.container orders it after gluetun (Requires/After);
   BindsTo stops it whenever gluetun goes away — also on a crash, when the
   namespace it lives in is gone — and WantedBy gluetun.service starts it
   again with gluetun. Docker needed a Salt `watch` for half of that. #}
{%- set g_unit = arrstack.gluetun.container_name ~ '.service' %}
{%- do arrstack.update({'attach': {
        'network': arrstack.gluetun.container_name ~ '.container',
        'unit': {'BindsTo': [g_unit]},
        'wanted_by': ['multi-user.target', g_unit],
    }}) %}
