{%- from "orch/map.jinja" import orch with context -%}
{%- set timer = orch.reboot.timer -%}
# Managed by Salt (formulas/orch) — do not edit.
[Unit]
Description=Nightly rolling reboot of minions with a pending reboot

[Timer]
OnCalendar={{ timer.on_calendar }}
# No Persistent: a missed night must not turn into a reboot run at boot.

[Install]
WantedBy=timers.target
