{%- from "backup/map.jinja" import backup with context -%}
# Managed by Salt (formulas/backup) — do not edit.
[Unit]
Description=restic backup to the NAS
Wants=network-online.target
After=network-online.target
{%- if backup.dumps %}
# dumps run via podman exec in these containers (Quadlet units).
{%- for d in backup.dumps %}
After={{ d.container }}.service
{%- endfor %}
{%- endif %}
# Fails (no metrics written -> BackupStale) instead of running without the share.
RequiresMountsFor={{ backup.repo_base }}

[Service]
Type=oneshot
EnvironmentFile={{ backup.config_dir }}/env
{%- if backup.stop_containers %}
# "-": a missing container doesn't stop the backup; ExecStopPost also runs
# after a failed or timed-out start. --no-block: queue the starts, never
# wait on them from inside this unit's stop.
ExecStartPre=-{{ backup.systemctl_bin }} stop {{ backup.stop_containers | join(' ') }}
{%- endif %}
ExecStart={{ backup.script }}
{%- if backup.stop_containers %}
ExecStopPost=-{{ backup.systemctl_bin }} start --no-block {{ backup.stop_containers | join(' ') }}
{%- endif %}
TimeoutStartSec={{ backup.timeout }}
Nice=10
IOSchedulingClass=idle
