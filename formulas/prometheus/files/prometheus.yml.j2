{%- from "prometheus/map.jinja" import prometheus with context %}
{%- set alerting = pillar.get('prometheus', {}).get('alerting', []) %}
{%- set scrape_configs = pillar.get('prometheus', {}).get('scrape_configs', [
    {'job_name': 'prometheus', 'static_configs': [{'targets': ['localhost:9090']}]},
]) %}
global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/{{ prometheus.rules_file }}
{%- if alerting %}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
{%- for target in alerting %}
            - {{ target }}
{%- endfor %}
{%- endif %}

scrape_configs:
{%- for job in scrape_configs %}
{#- A job with `mine:` gets one target per minion that publishes
   mine.alias (formulas/node-exporter, formulas/cadvisor), labelled with
   the minion ID. Rendered on this minion, so it sees the mine as of this
   state run — a new minion shows up after its own highstate plus one here. #}
{%- set static_configs = job.get('static_configs', []) | list %}
{%- if job.get('mine') %}
{%- for minion, ips in salt['mine.get']('*', job.mine.alias) | dictsort if ips %}
{%- do static_configs.append({'targets': [ips[0] ~ ':' ~ job.mine.port], 'labels': {'instance': minion}}) %}
{%- endfor %}
{%- endif %}
{#- A job with `probe:` scrapes a blackbox exporter (formulas/blackbox-exporter)
   instead of the targets themselves: each target URL becomes the exporter's
   ?target= param. probe.homepage: one target per pillar/homepage.sls item
   with a status dot — same rule as formulas/homepage's services.yaml.j2
   (siteMonitor, default href; false = none). #}
{%- set probe = job.get('probe') %}
{%- if probe and probe.get('homepage') %}
{%- for group in pillar.get('homepage', {}).get('services', []) %}
{%- for item in group.get('items', []) %}
{%- set url = item.get('siteMonitor', item.get('href')) %}
{%- if url %}
{%- do static_configs.append({'targets': [url], 'labels': {'instance': item.name, 'group': group.name}}) %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
  - job_name: {{ job.job_name }}
{%- if probe %}
    metrics_path: /probe
    params:
      module: [{{ probe.module }}]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: url
      - target_label: __address__
        replacement: {{ probe.exporter }}
{%- endif %}
{%- if not static_configs %}
    static_configs: []
{%- else %}
    static_configs:
{%- endif %}
{%- for sc in static_configs %}
      - targets:
{%- for target in sc.get('targets', []) %}
          - {{ target | json }}
{%- endfor %}
{%- if sc.get('labels') %}
        labels:
{%- for key, value in sc.labels.items() %}
          {{ key }}: {{ value | json }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endfor %}
