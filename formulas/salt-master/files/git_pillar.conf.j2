{%- from "salt-master/map.jinja" import salt_master with context %}
# Managed by formulas/salt-master — pillar data comes from the same repo
# as the state tree, just a different root inside it.
#
# Provider must match gitfs's: the privkey/pubkey auth params below are
# silently unsupported under gitpython, which logs them as such and then
# fails to authenticate.
git_pillar_provider: {{ salt_master.git_provider }}
# Same branch-to-base mapping as gitfs_base: git_pillar_base also defaults
# to 'master', and a branch that doesn't match it becomes a pillarenv of
# its own name instead of `base`, leaving pillar/top.sls's `base:` unmatched.
git_pillar_base: {{ salt_master.git_branch }}

ext_pillar:
  - git:
    - {{ salt_master.git_branch }} {{ salt_master.gitfs_remote }}:
      - root: {{ salt_master.pillar_root }}
      - privkey: {{ salt_master.deploy_key_dir }}/id_ed25519
      - pubkey: {{ salt_master.deploy_key_dir }}/id_ed25519.pub
