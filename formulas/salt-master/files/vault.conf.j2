{%- from "salt-master/map.jinja" import salt_master with context %}
{#-
  secret_id has to be the literal credential, not a path: saltext.vault
  takes config["auth"]["secret_id"] verbatim (factory.py) and never reads a
  file, so a path here just gets sent to OpenBao as the secret ID and comes
  back as "invalid role or secret ID". So the value is read out of the file
  at render time instead — the file stays the source of truth and stays out
  of git, and rotating the credential means replacing the file and
  re-applying this state.

  file_exists is checked first so a missing file produces the clean
  failure from vault.sls's file.exists guard rather than a render error.
-#}
{%- if salt['file.file_exists'](salt_master.vault_secret_id_file) %}
{%-   set vault_secret_id = salt['file.read'](salt_master.vault_secret_id_file).strip() %}
{%- else %}
{%-   set vault_secret_id = '' %}
{%- endif %}
# Managed by formulas/salt-master — OpenBao (Vault-API-compatible) auth for
# the sdb driver, so pillar values can reference sdb://<profile>/<path>?<key>
# instead of storing secrets in git. See CLAUDE.md "Secrets in pillar".
#
# This file contains the AppRole secret_id in clear — it is mode 0640
# root:<salt user>, and it is generated, never committed.
vault:
  auth:
    method: approle
    role_id: {{ salt_master.vault_role_id }}
    secret_id: {{ vault_secret_id }}
  server:
    url: {{ salt_master.vault_addr }}
{%- if salt_master.vault_ca_cert %}
    # CA bundle the master validates OpenBao's TLS cert against. Needed
    # whenever vault_addr is https with a cert no system trust store knows
    # (self-signed or an internal CA) — without it the handshake fails and
    # the error usually reads as an auth failure, not a TLS one.
    verify: {{ salt_master.vault_ca_cert_file }}
{%- endif %}
{%- if salt_master.vault_policies %}
  # saltext.vault issues a child token for any minion context — pillar
  # rendering counts as one — and OpenBao refuses a child token whose
  # policies aren't a subset of the parent's. The default list names
  # saltstack/* policies that don't exist here, which fails as
  # "child policies must be subset of parent", so this has to name what
  # the master's AppRole actually holds.
  policies:
    assign:
{%- for pol in salt_master.vault_policies %}
      - {{ pol }}
{%- endfor %}
{%- endif %}

# The sdb profile is a TOP-LEVEL config key, not nested under an `sdb:`
# mapping — Salt resolves a reference by looking the profile name up
# directly in the master opts (salt.utils.sdb.sdb_get does
# `opts.get("{{ salt_master.sdb_profile }}")`). Nested under `sdb:` it is never
# found, and the reference silently resolves to the literal URI string
# instead of erroring.
#
# No path-prefix option exists on this driver — every sdb:// reference
# elsewhere in pillar must spell out the full KV path itself, e.g.
# sdb://{{ salt_master.sdb_profile }}/{{ salt_master.sdb_kv_path }}/<subpath>?<key>
{{ salt_master.sdb_profile }}:
  driver: vault
