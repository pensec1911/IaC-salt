{%- from "salt-master/map.jinja" import salt_master with context %}
# Managed by formulas/salt-master — event tag -> reactor SLS. Reactor SLS
# files stay thin: they only dispatch a job, the logic lives in states.
{%- set reactions = [] %}
{%- if salt_master.highstate_on_start %}
{%- do reactions.append(('salt/minion/*/start', salt_master.reactor_sls,
    'A minion (re)started: VM fresh from Tofu, reboot, salt-minion restart.')) %}
{%- endif %}
{%- if salt_master.mine_consumers %}
{%- do reactions.append((salt_master.mine_event_tag, salt_master.mine_reactor_sls,
    'A minion changed its Salt Mine entries (formulas/node-exporter, cadvisor).')) %}
{%- endif %}
{%- if salt_master.beacon_restart_services %}
{%- do reactions.append((salt_master.beacon_service_tag, salt_master.beacon_service_reactor_sls,
    'A minion\'s service beacon reported a status change (formulas/salt-minion).')) %}
{%- endif %}
{%- if salt_master.api_enabled and salt_master.api_alertmanager_token %}
{%- do reactions.append((salt_master.alertmanager_hook_tag, salt_master.alertmanager_reactor_sls,
    'Alertmanager posted to salt-api /hook/alertmanager (pillar/alertmanager.sls).')) %}
{%- endif %}
{%- if salt_master.api_enabled and salt_master.api_git_hmac_secret %}
{%- do reactions.append((salt_master.git_hook_tag, salt_master.git_reactor_sls,
    'The git server posted a push to salt-api /hook/git (HMAC-signed).')) %}
{%- endif %}
{%- if salt_master.push_deploy %}
{%- do reactions.append((salt_master.push_event_tag, salt_master.push_reactor_sls,
    'gitfs fetched; changed = a push arrived (fileserver_events in gitfs.conf).')) %}
{%- endif %}
{%- if reactions %}
reactor:
{%- for tag, sls, why in reactions %}
  # {{ why }}
  - {{ tag | yaml_encode }}:
    - {{ sls }}
{%- endfor %}
{%- else %}
reactor: []
{%- endif %}

# Not a Salt option — read by the mine reactor SLS via `opts`, since a
# reactor SLS has no pillar of its own.
homelab_mine_consumers: {{ salt_master.mine_consumers | json }}
homelab_beacon_restart_services: {{ salt_master.beacon_restart_services | json }}
homelab_push_orch_sls: {{ salt_master.push_orch_sls | json }}
