{%- from "wazuh/map.jinja" import wazuh with context %}
{#- Inner content of the package's own <indexer> block (the <indexer>/
   </indexer> lines are the blockreplace markers). Per Wazuh's guide the
   manager authenticates with the Filebeat cert; the username/password come
   from wazuh-keystore (manager.sls), never inline here. #}
    <enabled>yes</enabled>
    <hosts>
      <host>https://{{ wazuh.node_ip }}:{{ wazuh.indexer_port }}</host>
    </hosts>
    <ssl>
      <certificate_authorities>
        <ca>{{ wazuh.filebeat.certs_dir }}/root-ca.pem</ca>
      </certificate_authorities>
      <certificate>{{ wazuh.filebeat.certs_dir }}/filebeat.pem</certificate>
      <key>{{ wazuh.filebeat.certs_dir }}/filebeat-key.pem</key>
    </ssl>
