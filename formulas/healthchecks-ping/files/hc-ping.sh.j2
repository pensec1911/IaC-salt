{%- from "healthchecks-ping/map.jinja" import hc_ping with context -%}
#!/bin/sh
# Managed by Salt (formulas/healthchecks-ping) — do not edit here.
#
# hc-ping <slug> <status>  — ping Healthchecks check <slug> (auto-created).
#   status: 0 = success, fail, 1-255 = failed exit code,
#           systemd = from $SERVICE_RESULT (use in ExecStopPost=).
# Returns at once and always exits 0: the request runs detached in a
# transient systemd unit (--send), retrying for a few minutes. Never let a
# ping break the job that sends it.
set -u
ENV_FILE="{{ hc_ping.env_file }}"

if [ "${1:-}" = "--send" ]; then
    # Detached half: read the key-bearing URL here, not on a command line.
    [ -r "$ENV_FILE" ] || exit 0
    . "$ENV_FILE"
    suffix=""
    [ "$3" = "0" ] || suffix="/$3"
    exec {{ hc_ping.curl_bin }} -fsS -o /dev/null -m {{ hc_ping.max_time }} \
        --retry 100 --retry-all-errors --retry-delay {{ hc_ping.retry_delay }} \
        --retry-max-time {{ hc_ping.retry_max_time }} \
        "$HC_PING_URL/$2$suffix?create=1"
fi

slug="${1:-}"
status="${2:-0}"
case "$slug" in
    ""|*[!a-z0-9_-]*) echo "hc-ping: bad slug '$slug'" >&2; exit 0 ;;
esac
if [ "$status" = "systemd" ]; then
    if [ "${SERVICE_RESULT:-}" = "success" ]; then status=0; else status=fail; fi
fi
case "$status" in
    fail|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]) ;;
    *) status=fail ;;
esac

{{ hc_ping.systemd_run_bin }} --quiet --no-block --collect \
    --description="Healthchecks ping $slug" \
    "{{ hc_ping.script }}" --send "$slug" "$status" >/dev/null 2>&1 || true
exit 0
